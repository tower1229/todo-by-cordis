{
  "name": "todo-by-cordis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "24.18.x"
  },
  "scripts": {
    "test": "node --import tsx --test --test-concurrency=1 tests/app/*.test.ts",
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.server.json && node --import tsx scripts/build-client.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.plugins.json && tsc -p tsconfig.scripts.json",
    "test:e2e": "playwright test",
    "accept": "playwright test tests/e2e/todo-six-step.spec.ts tests/e2e/inventory-migration.spec.ts",
    "accept:real-model": "node --import tsx scripts/accept-real-model.ts"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "@base-ui/react": "1.8.0",
    "@hono/node-server": "2.1.6",
    "cordis": "4.0.0-rc.9",
    "hono": "4.13.16",
    "lucide-react": "1.41.0",
    "playwright": "1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "vite": "8.2.4"
  }
}
